{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevBench",
  "mainBinaryName": "devbench",
  "version": "0.4.0",
  "identifier": "io.github.devbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevBench",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#0d1322",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Control center for home servers and their virtual machines",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDRjA0MzNBQUIxNTQzQjQKUldTMFF4V3JPa1B3N0ZKM21lTnVaTURaUWRIMEpCT3JPa0c2WEY1SDNDWUhGbGhmdGxzS1I5Nk0K",
      "endpoints": ["https://github.com/MosesCommitsFraud/DevBench/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
